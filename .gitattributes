# Normalise every text file to LF in the repository, regardless of the
# contributor's `core.autocrlf` setting. Windows batch files stay CRLF because
# cmd.exe requires it.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted or diffed as text.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.exe binary
*.msi binary
*.dll binary
*.zip binary

# Generated documentation and dependency lockfiles: collapse them in diffs.
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
src/features/docs/docs-index.generated.json linguist-generated=true
src/lib/tauri/bindings.ts linguist-generated=true
