{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Detergo Setup",
  "version": "1.0.0",
  "identifier": "com.vellium.detergo.setup",
  "mainBinaryName": "detergo-setup",
  "build": {
    "frontendDist": "../dist-setup"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Detergo Setup",
        "url": "setup.html",
        "width": 640,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "center": true,
        "shadow": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.ico"]
  }
}
