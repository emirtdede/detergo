{
  "name": "node-cleaner",
  "private": true,
  "version": "2.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:a11y": "npm run check:contrast && playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:audit": "node scripts/check-audit-invariants.mjs",
    "check:i18n": "node scripts/check-i18n-scripts.mjs && node scripts/check-i18n-coverage.mjs && node scripts/check-i18n-untranslated.mjs",
    "check:i18n:coverage": "node scripts/check-i18n-coverage.mjs",
    "check:i18n:untranslated": "node scripts/check-i18n-untranslated.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-version": "node scripts/check-version.js",
    "check:build-info": "node scripts/check-build-info.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:languages": "node scripts/check-installer-languages.mjs",
    "check:exe-icons": "node scripts/check-exe-icons.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:icons:verify": "node scripts/verify-icon-determinism.mjs",
    "build:social-preview": "node scripts/build-social-preview.mjs",
    "build:release": "node scripts/build-release.js",
    "verify:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-smoke.ps1",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer.ps1",
    "verify:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-msi.ps1",
    "verify:upgrade": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-upgrade.ps1",
    "verify:shell-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-shell-icons.ps1",
    "verify:trash": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-recycle-bin.ps1",
    "verify:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-offline.ps1",
    "bench:scale": "cargo test --manifest-path src-tauri/Cargo.toml --release --test scale_benchmark -- --ignored --nocapture",
    "bench:entries": "cargo test --manifest-path src-tauri/Cargo.toml --release --test entry_benchmark -- --ignored --nocapture",
    "bench:measure": "cargo test --manifest-path src-tauri/Cargo.toml --release --test measure_benchmark -- --ignored --nocapture"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "@tauri-apps/api": "^2.2.1",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.2.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "opentype.js": "1.3.4",
    "prettier": "^3.4.2",
    "sharp": "0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
