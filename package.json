{
  "name": "node-cleaner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:a11y": "npm run check:contrast && playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "check-version": "node scripts/check-version.js",
    "build:release": "node scripts/build-release.js",
    "verify:trash": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-recycle-bin.ps1",
    "verify:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-offline.ps1",
    "bench:scale": "cargo test --manifest-path src-tauri/Cargo.toml --release --test scale_benchmark -- --ignored --nocapture",
    "bench:entries": "cargo test --manifest-path src-tauri/Cargo.toml --release --test entry_benchmark -- --ignored --nocapture",
    "bench:measure": "cargo test --manifest-path src-tauri/Cargo.toml --release --test measure_benchmark -- --ignored --nocapture"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
