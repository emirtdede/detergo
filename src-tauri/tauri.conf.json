{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Cleaner",
  "version": "1.0.1",
  "identifier": "com.vellium.devcleaner",
  "mainBinaryName": "dev-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Cleaner",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "center": true,
        "shadow": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vellium",
    "homepage": "https://vellium.dev",
    "license": "Proprietary",
    "category": "DeveloperTool",
    "copyright": "© 2026 Vellium",
    "shortDescription": "Safely analyze and clean developer artifacts and AI agent storage.",
    "longDescription": "Dev Cleaner is a local Windows application that analyzes, in one place, the reproducible dependency, build and cache outputs of ecosystems such as Node.js/Python/Rust/.NET/Java/Go, together with the local storage of AI coding agents such as Codex, Claude Code and Antigravity. Only verified and explicitly selected targets are moved to the Windows Recycle Bin; permanent deletion requires a separate confirmation. The application runs fully offline and sends no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": ["tr-TR", "en-US"],
        "upgradeCode": "40ef2964-2821-54d7-ac14-2894d8e84709",
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "uninstallerHeaderImage": "nsis/unheader.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "installMode": "currentUser",
